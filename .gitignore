# ==========================================
# Root .gitignore for Monorepo
# (Frontend, Backend & Vanilla JS)
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production Build Outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/build/
*.local

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Editor & IDE Configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace
.agents/
.gemini/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Vite / Bundler Cache
.vite/
*/.vite/
.turbo/
.cache/

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/

# Temporary & Log files
*.tmp
*.temp
*.log
